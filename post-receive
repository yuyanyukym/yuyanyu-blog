#!/bin/bash
# Post-receive hook for static deployment (no build on VPS)

REPO_PATH="/home/xiaobai/xiaobai-blog.git"
DEPLOY_PATH="/home/xiaobai/xiaobai-blog-deploy"
NGINX_ROOT="/home/xiaobai/xiaobai-blog/public"

echo "✓ Push received. Deploying static files..."

mkdir -p "$DEPLOY_PATH"

# Read pushed branch from stdin
while read oldref newref refname; do
  branch=$(basename "$refname")
  echo "Checking out $branch"
  git --work-tree="$DEPLOY_PATH" --git-dir="$REPO_PATH" checkout -f "$branch"
done

# Sync dist/ to Nginx root
if [ -d "$DEPLOY_PATH/dist" ]; then
  mkdir -p "$NGINX_ROOT"
  rsync -av --delete "$DEPLOY_PATH/dist/" "$NGINX_ROOT/"
  echo "✓ Deployment complete"
else
  echo "✗ dist/ not found. Ensure 'npm run build' was run locally before push."
  exit 1
fi

exit 0
